# DataRobot API Credentials (required for local development)
# For Codespace, these are typically set automatically
DATAROBOT_ENDPOINT="https://app.datarobot.com"
DATAROBOT_API_TOKEN="your-api-token-here"
DATAROBOT_DEFAULT_USE_CASE="optional-use-case-id"

# Datasets 
ERCOT_TRAINING_DATASET_ID="xxx"
SCORING_BASE_DATASET_ID="xxx"

# Deployments
FORECAST_DEPLOYMENT_ID="xxx"
MCP_DEPLOYMENT_ID="xxx"

# Prompt template
PROMPT_TEMPLATE_ID="xxx"

# Optional: Document Intelligence / Aryn
# If not set, the PDF notebook will run in simulation mode
ARYN_API_KEY="optional-aryn-api-key"
