# Copy this file to `.env` and fill in your values:
#   cp env.example .env
#
# Notes:
# - In DataRobot-hosted notebooks, authentication is often injected automatically.
# - For local development, DATAROBOT_ENDPOINT and DATAROBOT_API_TOKEN are required.

### DataRobot authentication (required for local)
#DATAROBOT_ENDPOINT=
#DATAROBOT_API_TOKEN=

### LLM Gateway model id
MODEL_NAME="azure/gpt-5-1-2025-11-13"

### MCP tool deployment (used in notebooks 3–5)
MCP_DEPLOYMENT_ID=

### Forecasting tool inputs (used in notebook 4)
FORECAST_DEPLOYMENT_ID=
SCORING_DATASET_ID=

### Prompt management (used in notebooks 2 and 4)
PROMPT_TEMPLATE_ID=

### Data tools (used in notebook 3)
ERCOT_TRAINING_DATASET_ID=

### Use Case IDs and naming
# Notebook 5 optionally tags VDB creation to a use case.
# Notebook 6 links registered model versions and deployments to this use case.
DATAROBOT_DEFAULT_USE_CASE=

# Notebook 6 also expects explicit names for the custom model
# and registered model. Keep these unique to you (e.g., include
# your initials so multiple people can run the workshop safely).
CUSTOM_MODEL_NAME="SKO Ercot Agent Workflow - YOUR-INITIALS"
REGISTERED_MODEL_NAME="SKO Ercot Forecast Agent - YOUR-INITIALS"