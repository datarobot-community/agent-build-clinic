# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# Notes:
# - In DataRobot-hosted notebooks, authentication is often injected automatically.
# - For local development, DATAROBOT_ENDPOINT and DATAROBOT_API_TOKEN are required.

### DataRobot authentication (required for local)
#DATAROBOT_ENDPOINT=
#DATAROBOT_API_TOKEN=
#DATAROBOT_DEFAULT_USE_CASE=

# Names for the custom model and registered model
# UPDATE: e.g. include your initials!
CUSTOM_MODEL_NAME="Ercot Agent Workflow - YOUR-INITIALS"
REGISTERED_MODEL_NAME="Ercot Forecast Agent - YOUR-INITIALS"

### MCP tool deployment (created in notebook 0; used in notebooks 2–5)
# Pulumi stack name for the MCP template deploy (notebook 0). Use a unique value per person (e.g. my-mcp-stack-YOUR-INITIALS).
MCP_STACK_NAME=
# Session secret key for the MCP server
SESSION_SECRET_KEY="secretkey123"
# Default execution environment for the MCP server
DATAROBOT_DEFAULT_MCP_EXECUTION_ENVIRONMENT="Python 3.11 GenAI Agents"

# Set after deploy: from Pulumi output, or from the deployment in the DataRobot app (see notebook 0).
MCP_DEPLOYMENT_ID=

### Forecasting tool inputs (used in notebook 4)
FORECAST_DEPLOYMENT_ID=
SCORING_DATASET_ID=

### Data tools (used in notebook 3)
ERCOT_TRAINING_DATASET_ID=

### LLM Gateway model id
MODEL_NAME="azure/gpt-5-1-2025-11-13"

### Prompt template (notebooks 2 and 4)
#PROMPT_TEMPLATE_ID=