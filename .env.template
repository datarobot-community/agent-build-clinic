# ABC Forecast App — ERCOT DAM (Agent Build Clinic)
# See agent_spec.md for full design alignment with the clinic slides.

# Your DataRobot API token.
# Refer to https://docs.datarobot.com/en/docs/api/api-quickstart/index.html#configure-your-environment for help.
DATAROBOT_API_TOKEN=

# The URL of your DataRobot instance API.
DATAROBOT_ENDPOINT=https://app.datarobot.com/api/v2

# Local endpoint for agent component
AGENT_PORT=8842

# Use the DRAgent as frontserver of the agent instead of DR agent
ENABLE_DRAGENT_SERVER=false

# The Pulumi stack name to use for this project.
PULUMI_STACK_NAME=agent-application-dev

# If empty, a blank passphrase will be used
PULUMI_CONFIG_PASSPHRASE=123

# Skip Pulumi update check to prevent issues with rate limiting
PULUMI_SKIP_UPDATE_CHECK=1

# If empty, a new use case will be created
DATAROBOT_DEFAULT_USE_CASE=

# If empty, a new execution environment will be created for each agent using the docker_context folder
DATAROBOT_DEFAULT_EXECUTION_ENVIRONMENT="[DataRobot] Python 3.11 GenAI Agents"

# If empty, the latest version of the execution environment will be used
DATAROBOT_DEFAULT_EXECUTION_ENVIRONMENT_VERSION_ID="69d773b9881f02076d40b5e2"

# Required: Random string for Web application security.
SESSION_SECRET_KEY=

# LLM Gateway (default)
INFRA_ENABLE_LLM=gateway_direct.py
LLM_DEFAULT_MODEL=datarobot/anthropic/claude-sonnet-4-5-20250929

APP_LOG_LEVEL=CRITICAL

# --- DataRobot Global MCP (required — no local mcp_server in this app) -----
# https://docs.datarobot.com/en/docs/agentic-ai/agentic-mcp/agentic-mcp-clients.html
# Replace {DATAROBOT_URL} with your host (e.g. app.datarobot.com) and set your API token.
EXTERNAL_MCP_URL=https://app.datarobot.com/api/v2/genai/globalmcp/mcp
EXTERNAL_MCP_HEADERS={"Authorization": "Bearer <DATAROBOT_API_TOKEN>"}
EXTERNAL_MCP_TRANSPORT=streamable-http

# Do NOT set MCP_DEPLOYMENT_ID — this app does not deploy a standalone MCP server.

# ABC Forecast App — clinic env mapping:
#   ERCOT_DEPLOYMENT_ID  ← clinic FORECAST_DEPLOYMENT_ID (time-series forecast model)
#   ERCOT_DATASET_ID     ← clinic ERCOT_TRAINING_DATASET_ID (historical DAM + weather)
# Clinic POV examples (replace with your IDs):
#   ERCOT_DEPLOYMENT_ID=698e049a2720aafce2802a0c
#   ERCOT_DATASET_ID=6a6169d0d26541f54266b049
ERCOT_DEPLOYMENT_ID=
ERCOT_DATASET_ID=6a6169d0d26541f54266b049
# Optional: pre-built scoring dataset (clinic example: 698f3ae36603c710354245fd).
# SCORING_DATASET_ID=
#TAVILY_API_KEY=
